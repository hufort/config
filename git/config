[user]
	name = hufort
	email = hugh.forte@gmail.com

[core]
	excludesfile = ~/Code/config/git/ignore

[alias]
	a = add
	b = branch
	c = commit
	d = diff
	l = log
	f = fetch
	u = pull
	m = merge
	p = push
	r = rebase
	s = status
	branches = for-each-ref --sort=-committerdate --format='%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)' refs/remotes

[push]
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[fetch]
	prune = true

[init]
	defaultBranch = main

[help]
	autocorrect = 1

[blame]
	ignoreRevsFile = .git-blame-ignore-revs
